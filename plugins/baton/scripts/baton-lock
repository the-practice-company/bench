#!/usr/bin/env bash
# Hold, inspect, release or take over the baton writer role.
# The role is held for the whole session, not per write: two sessions taking
# turns to write would remove the race but not the divergence.
#
# This is a LEASE, not a pid-liveness check. Claude Code's Bash tool spawns a
# fresh shell per invocation, so a pid recorded from inside one tool call is
# already gone by the next -- there is no durable, session-scoped pid to
# observe from here. A parent process that does survive across calls (the
# harness itself) is not scoped to a single session either, so it cannot be
# borrowed as a substitute. Do not "fix" this by resurrecting a kill -0
# check; it was tried and it does not distinguish anything.
#
# Instead: a session is considered live while its recorded acquisition time
# is recent. It goes stale on its own after STALE_SECONDS, no process
# inspection required. Because a lease alone would strand a run for up to
# six hours after a real crash, `takeover` exists as an explicit, always-
# succeeding escape hatch -- stealing an unexpired lease is then a
# deliberate, visible act instead of an accident.
set -euo pipefail

STALE_SECONDS=21600   # six hours
FUTURE_SKEW=60         # tolerate up to a minute of clock drift

LOCK_DIR=".baton"
LOCK_FILE="$LOCK_DIR/lock"

usage() {
    echo "usage: baton-lock {acquire|check|release|takeover} <session-id>" >&2
    exit 64
}

[ $# -eq 2 ] || usage
cmd="$1"
session="$2"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "baton-lock: not a git repository" >&2
    exit 1
fi

# LOCK_FILE is relative, so without this the lease's location depends on the
# caller's cwd: acquiring from a subdirectory writes <subdir>/.baton/lock,
# invisible to a check or acquire run from the repo root (or any other
# subdirectory). That silently defeats the single-writer guarantee this
# script exists to provide -- two sessions can both believe they hold it.
cd "$(git rev-parse --show-toplevel)"

# Prints the value of field $1 from the lock file, or nothing. Never aborts:
# if the file vanishes between lock_state's -f test and this read, sed fails
# but the function still degrades to an empty result instead of taking the
# whole script down with it (pipefail would otherwise propagate sed's exit
# code through head's success).
read_field() {
    sed -n "s/^$1=//p" "$LOCK_FILE" 2>/dev/null | head -1 || true
}

is_digits() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

# Prints one of: none | ours | live | expired
lock_state() {
    if [ ! -f "$LOCK_FILE" ]; then
        echo none
        return
    fi

    local owner acquired now
    owner="$(read_field session)"
    if [ "$owner" = "$session" ]; then
        echo ours
        return
    fi

    acquired="$(read_field acquired_epoch)"
    now="$(date -u +%s)"

    # Anything unparseable fails OPEN to expired: a garbled field must never
    # make the run unrecoverable.
    if ! is_digits "$acquired"; then
        echo expired
        return
    fi
    if [ "$((acquired - now))" -gt "$FUTURE_SKEW" ]; then
        echo expired
        return
    fi
    if [ "$((now - acquired))" -ge "$STALE_SECONDS" ]; then
        echo expired
        return
    fi

    echo live
}

# Refreshing our own lock IS the heartbeat under a lease: a live session
# keeps its lease alive by re-acquiring periodically, which just rewrites
# acquired_epoch forward. That is expected, not a wart.
write_lock() {
    mkdir -p "$LOCK_DIR"
    local tmp="$LOCK_DIR/.lock.tmp.$$"
    # Double-quoted so $tmp is expanded now, while it's still in scope: by
    # the time this trap fires at script exit, write_lock's local has long
    # since gone out of scope, and a deferred expansion would read as unset.
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" EXIT
    {
        printf 'session=%s\n' "$session"
        # pid is forensics for a human staring at a wedged run -- nothing in
        # this script reads it back to decide liveness. Never write a pid
        # that did not come straight from the shell.
        printf 'pid=%s\n' "$PPID"
        printf 'acquired=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'acquired_epoch=%s\n' "$(date -u +%s)"
    } > "$tmp"
    mv "$tmp" "$LOCK_FILE"
}

# O_EXCL create for the genuinely-free case only: two concurrent `acquire`
# calls can both observe `none`, but only one `>` under noclobber wins: the
# loser gets EEXIST instead of clobbering the winner. Returns non-zero if we
# lost the race.
acquire_free() {
    mkdir -p "$LOCK_DIR"
    (
        set -o noclobber
        {
            printf 'session=%s\n' "$session"
            printf 'pid=%s\n' "$PPID"
            printf 'acquired=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            printf 'acquired_epoch=%s\n' "$(date -u +%s)"
        } > "$LOCK_FILE"
    ) 2>/dev/null
}

state="$(lock_state)"

case "$cmd" in
    acquire)
        case "$state" in
            none)
                if ! acquire_free; then
                    echo "baton-lock: lost the race for a free lock" >&2
                    exit 3
                fi
                ;;
            ours)
                write_lock
                ;;
            expired)
                previous="$(read_field session)"
                write_lock
                printf 'takeover=%s\n' "$previous"
                ;;
            live)
                echo "baton-lock: held by live session $(read_field session)" >&2
                exit 3
                ;;
        esac
        ;;
    check)
        case "$state" in
            ours)    exit 0 ;;
            live)    exit 3 ;;
            expired) exit 4 ;;
            none)    exit 5 ;;
        esac
        ;;
    release)
        case "$state" in
            ours) rm -f "$LOCK_FILE" ;;
            none) : ;;
            *)
                echo "baton-lock: refusing to release a lock we do not hold" >&2
                exit 3
                ;;
        esac
        ;;
    takeover)
        # Always succeeds, regardless of state: this is the deliberate,
        # visible escape hatch that keeps a lease from stranding a run.
        # Plain mv, not O_EXCL: an rm-then-create window here would let a
        # third racer steal the file between removal and creation, which is
        # worse than what we have today. Accepted because a takeover is
        # journaled and surfaces downstream as `suspect`.
        previous=""
        [ "$state" = "none" ] || previous="$(read_field session)"
        write_lock
        [ -z "$previous" ] || printf 'takeover=%s\n' "$previous"
        ;;
    *) usage ;;
esac
