#!/usr/bin/env bash
# Gather the mechanical half of a wave gate: run the constitution's
# verify_cmd, and scan the files a wave touched for placeholder markers.
#
# This script decides nothing. It does not know what a wave is, does not
# read state.md, and never sets a status. Exit criteria are EARS prose and
# only the agent can check them; what a machine can establish is what this
# collects, so that the agent's verdict has something under it besides
# recollection.
#
# Exit codes:
#   0   evidence gathered -- read verify_exit and placeholder_hits. A red
#       gate is exit 0 with verify_exit non-zero, NOT a non-zero exit of
#       this script. A script that exited non-zero both when the tests
#       failed and when it could not run them would make those two
#       indistinguishable to its only caller, and they call for opposite
#       responses: fix the code, versus stop and report the tooling.
#   1   not a git repository
#   3   docs/baton/constitution.md is missing, is not ratified, or still
#       carries an unfilled placeholder marker
#   4   verify_cmd is empty, names a command that cannot be run, or .baton/
#       could not be prepared to receive the log
#   64  usage error, including a --since that is not a commit
#   *   any other non-zero code comes from awk or git, not from this
#       script's own logic, and means the constitution could not be read
#       or the repository could not be queried -- see baton-observe, which
#       carries the same catch-all for the same reason.
set -euo pipefail

usage() { echo "usage: baton-gate --since <SHA>" >&2; exit 64; }

since=""
while [ $# -gt 0 ]; do
    case "$1" in
        --since)
            [ $# -ge 2 ] || usage
            since="$2"
            shift 2
            ;;
        -h|--help) usage ;;
        *) usage ;;
    esac
done
[ -n "$since" ] || usage

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "baton-gate: not a git repository" >&2
    exit 1
fi

# baton-write, baton-lock, baton-journal and baton-observe were each fixed
# for this once already: invoked from a subdirectory, every relative path
# below names something that is not there. The assignment is kept separate
# from the cd rather than inlined as `cd "$(...)"`: under bash 3.2, `cd ""`
# (what a failed command substitution leaves behind) returns 0 and leaves
# cwd untouched, so an inlined form would swallow a bare repository's
# `fatal: this operation must be run in a work tree` and carry on from
# whatever directory this happened to start in -- reaching the constitution
# check below and reporting the wrong reason (constitution not found)
# instead of the real one. Assigning first means a failure here aborts
# under set -e, with git's own message intact.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# The constitution guards run before --since is validated, not after: repo
# state is checked before argument syntax. A caller with both an
# unratified constitution and a garbage --since costs two round trips
# instead of one -- fix the constitution, then get told about --since --
# but the constitution's state does not depend on anything the caller
# typed, so it is the more useful failure to see first.
constitution="docs/baton/constitution.md"
if [ ! -f "$constitution" ]; then
    echo "baton-gate: $constitution not found: there is no run here to gate" >&2
    exit 3
fi

# Lines between the opening and closing --- only. A "status:" further down
# in the prose is not the frontmatter's -- and neither is one in a file
# whose frontmatter was never closed: buffering and emitting only on the
# terminator is what keeps an unterminated block from quietly redefining
# "frontmatter" as "everything after line 1", which is the one malformed
# shape that would otherwise be read as ratified.
frontmatter="$(awk '
    NR==1 && $0=="---" { infm=1; next }
    infm && $0=="---"  { closed=1; exit }
    infm               { buf = buf $0 "\n" }
    END                { if (closed) printf "%s", buf }
' "$constitution")"

# Prints the value of field $1 from the constitution's frontmatter, or
# nothing. Never aborts: if this is ever asked for a field with more than
# one matching line, sed keeps writing after head -1 has already taken its
# line and exited, sed receives SIGPIPE, and its exit code (141) would
# propagate through pipefail and take the whole script down with it under
# set -e -- baton-lock's read_field carries the same `|| true` guard for
# the same reason.
fm_field() {
    printf '%s\n' "$frontmatter" | sed -n "s/^$1: *//p" | head -1 || true
}

# One layer of surrounding quotes, since verify_cmd is conventionally
# written quoted and placeholder_patterns always is.
unquote() {
    local s="$1"
    case "$s" in
        \"*\") s="${s#\"}"; s="${s%\"}" ;;
        \'*\') s="${s#\'}"; s="${s%\'}" ;;
    esac
    printf '%s' "$s"
}

status="$(fm_field status)"
if [ "$status" != "ratified" ]; then
    echo "baton-gate: constitution status is '${status:-unset}', not ratified: gating a run that was never handed over judges work against rules nobody signed" >&2
    exit 3
fi

# Whole-file substring match, deliberately narrower than baton-resume's:
# baton-resume matches only a frontmatter field whose value begins with
# REPLACE-WITH, because a resume that halts permanently over the literal
# string surviving in a comment is worse than the alternative. A gate is
# different -- it only ever refuses once, not permanently -- so it fails
# closed instead: a constitution that quotes REPLACE-WITH anywhere in its
# prose, even as documentation, is refused until it is reworded.
if grep -q 'REPLACE-WITH' "$constitution"; then
    echo "baton-gate: the constitution still carries an unfilled placeholder marker; it has not been ratified whatever its status field says" >&2
    exit 3
fi

# --since sits here, between the two groups of constitution checks above and
# below it, deliberately -- not because "repo state" ends and "the rest"
# begins. verify_cmd's own checks below are repo state too, and they run
# after --since, not before it. Everything above this point is a handful of
# file reads; everything below it can run a whole test suite. A typo'd
# --since must not cost a real test run, so it is the last cheap thing
# checked before the expensive one, not the last thing checked, full stop.
if ! git rev-parse --verify -q "${since}^{commit}" >/dev/null 2>&1; then
    echo "baton-gate: --since '$since' is not a commit in this repository" >&2
    exit 64
fi

verify_cmd="$(unquote "$(fm_field verify_cmd)")"
if [ -z "$verify_cmd" ]; then
    echo "baton-gate: verify_cmd is empty in the constitution: there is nothing to run, so there is no evidence to gather" >&2
    exit 4
fi

# "CI=1 npm test", "NODE_ENV=test npx jest", "RAILS_ENV=test bundle exec
# rspec" are the ordinary shape of a test command, not an exotic one --
# CI=1 names npm, not CI=1. Refusing them would stop the run over nothing,
# and exit 4 means stop: verify_cmd lives in the constitution, which no tool
# here can edit to unblock it, so this guard errs toward letting a command
# word through rather than refusing one it merely failed to parse. What it
# strips is a leading run of plain NAME=VALUE words; a builtin, a keyword,
# or a first word carrying shell syntax (`[[`, a subshell, a redirect) is
# left alone and falls through to command -v below, which will correctly
# say no -- none of those is a runnable binary either.
verify_head="$verify_cmd"
while :; do
    case "$verify_head" in
        [[:space:]]*) verify_head="${verify_head#[[:space:]]}"; continue ;;
    esac
    verify_word="${verify_head%%[[:space:]]*}"
    case "$verify_word" in
        [A-Za-z_][A-Za-z0-9_]*=*) verify_head="${verify_head#"$verify_word"}" ;;
        *) break ;;
    esac
done
verify_bin="${verify_head%%[[:space:]]*}"

# command -v is asked about bash's own idea of "$verify_bin" -- which is why
# the run below uses bash too, not sh. A guard that consults one shell's
# builtins and keywords while the run uses another would pass words the run
# cannot execute: on the Debian family /bin/sh is dash, and bash's
# command -v vouches for `[[`, `source`, `let`, `declare` and `function`,
# none of which dash has. A verify_cmd of "[[ 1 == 1 ]]" run there under
# `sh -c` reports verify_exit=127 -- a command that was never found,
# arriving dressed as a suite that failed. This check is the first word
# only, so a binary missing later in the line (a pipeline's second stage, an
# `&&`'d command) is not caught here either -- that also surfaces as
# verify_exit=127, and the script deliberately does not remap it to a code
# of its own: a real test runner can legitimately propagate a 127 from
# something it invoked, and guessing which case this is would be worse than
# reporting the number as given. 127 means "did not run", not "did not
# pass" -- that reading belongs to the caller, and the baton-autopilot skill
# states it.
if ! command -v "$verify_bin" >/dev/null 2>&1; then
    echo "baton-gate: verify_cmd names '$verify_bin', which is not runnable here" >&2
    exit 4
fi

# .baton/ is gitignored by every /baton:init'd repository, which is the
# point: a gate run that left an untracked log behind would show up as a
# dirty tree at the next checkpoint and read as work in flight.
#
# Both steps below are guarded, and both exit 4 rather than letting a
# failure fall through into verify_exit: without this, a read-only .baton/
# (stale permissions, a full disk, a leftover root-owned log) makes the run
# below fail before the command is ever reached, and the $? from THAT looks
# exactly like a suite with a failing test -- the gate being unable to
# gather evidence, presenting as evidence that the code is broken. The mkdir
# guard also covers the case where .baton already exists as a plain file
# rather than a directory: unguarded, `mkdir -p` fails there and set -e
# would abort with no baton-gate: prefix and exit 1 -- a code the header
# table above already spends on "not a git repository".
mkdir -p .baton || {
    echo "baton-gate: cannot create .baton/ -- check whether something at that path is not a directory, or the parent is not writable" >&2
    exit 4
}
verify_log=".baton/gate-verify.log"
: > "$verify_log" || {
    echo "baton-gate: cannot write $verify_log -- check .baton/'s permissions and the filesystem's free space" >&2
    exit 4
}

verify_exit=0
# bash, the same shell command -v consulted above -- see the comment on the
# guard. Stdin is /dev/null regardless of what this script inherited: a
# verify_cmd that reads stdin (a bare `cat`, a runner left waiting on a
# prompt it was never given) would otherwise hang forever with no one left
# to answer it, which is the one outcome this whole feature exists to
# avoid -- it produces neither a closed wave nor a named stopping point.
bash -c "$verify_cmd" < /dev/null > "$verify_log" 2>&1 || verify_exit=$?

printf 'verify_cmd=%s\n' "$verify_cmd"
printf 'verify_exit=%s\n' "$verify_exit"
printf 'verify_log=%s\n' "$verify_log"
exit 0
