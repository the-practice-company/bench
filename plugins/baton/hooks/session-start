#!/usr/bin/env bash
# After a compaction, point the agent at the state file and hand it the three
# lines that matter, so recovery does not depend on remembering to recover.
set -euo pipefail

project="${CLAUDE_PROJECT_DIR:-$PWD}"
cd "$project" 2>/dev/null || exit 0

# CLAUDE_PROJECT_DIR is wherever the session started, not necessarily the
# git top level -- a monorepo session can start in a subdirectory just as
# easily as at the root. baton-lock, baton-write and baton-journal all had
# to re-resolve to the repository root for exactly this reason (see their
# comments): a hook invoked from a subdirectory would otherwise find no
# docs/baton/state.md and silently inject nothing, right when recovery
# depends on it. A baton run is always a git run, so anything that is not
# inside a repository at all genuinely is not our concern.
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    cd "$(git rev-parse --show-toplevel)"
else
    exit 0
fi

state="docs/baton/state.md"
[ -f "$state" ] || exit 0

# Claude Code passes hook input as JSON on stdin: session_id, transcript_path,
# hook_event_name, and source -- the field hooks.json's own SessionStart
# matcher (startup|resume|clear|compact|fork) already distinguishes. Until
# this hook reads it, that distinction never reaches the agent: baton-resume
# continues silently after a compact and waits on a fresh start, and it has
# no way to tell those apart. `cat` returns immediately on an empty or
# already-closed stdin, exactly how every test here (and every no-input
# invocation) drives this hook -- it does not wait on a terminal that was
# never attached.
hook_input="$(cat 2>/dev/null || true)"

# source is a five-value enum, so a targeted extraction is honest here; a
# general JSON parser hand-rolled in sed would not be. Same idiom as the
# escaper this hook already uses for its own output, further down. An
# absent field, malformed JSON, and a value outside the enum all collapse
# to the same "unknown" -- and because the value is validated against a
# fixed set of literals before it is ever interpolated below, a hostile
# string on stdin (an embedded quote, an attempted break-out) can only ever
# become one of these six fixed words, never reach the JSON escaper as
# untrusted data.
session_source="$(printf '%s' "$hook_input" | sed -n 's/.*"source"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
case "$session_source" in
    startup|resume|clear|compact|fork) ;;
    *) session_source="unknown" ;;
esac

field() {
    sed -n "s/^\*\*$1:\*\* *//p" "$state" | head -1
}

goal="$(field 'Goal')"
mode="$(field 'Operating mode')"
rules="$(field 'Non-negotiables')"
next="$(sed -n 's/^- \*\*Next action:\*\* *//p' "$state" | head -1)"

# Restricted to the frontmatter block, same as pre-compact's observed_sha
# read: unanchored, a stray "autopilot: ..." line in the body (e.g. a
# schema example) would be picked up too. Harmless in practice since
# head -1 always prefers the frontmatter occurrence -- frontmatter is
# always first in the file -- but there is no reason to rely on that.
#
# tr -d '\r' first: state.md is agent-written, and a CRLF-authored file has
# "---\r" for its delimiter lines, which "^---$" does not match -- the
# entire frontmatter block, not just one field, would silently disappear.
# That failure is silent in exactly the direction that looks like success:
# a genuine "autopilot: off" file and a file whose block match is simply
# broken both produce no Autopilot line, for entirely different reasons.
frontmatter="$(tr -d '\r' < "$state" | sed -n '/^---$/,/^---$/p')"
autopilot="$(printf '%s\n' "$frontmatter" | sed -n 's/^autopilot: *//p' | head -1)"
autopilot_grant="$(printf '%s\n' "$frontmatter" | sed -n 's/^autopilot_grant: *//p' | head -1)"

# state.md is written by an agent, not validated input, so the byte-level
# shape of a scalar drifts: a trailing space, a quoted string. Shared by
# autopilot (where the dangerous direction is a false positive -- an
# unrecognized value falls through to "announce it", and announcing a
# grant that was never made tells a session it may act unattended when the
# human set it to off) and by autopilot_grant (displayed verbatim: the
# line is what a compacted session reads to know which entry authorised
# this, and a stray quote or trailing space would make the id it prints
# not the id a human wrote).
trim_unquote() {
    local v
    v="$(printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    case "$v" in
        \"*\") v="${v#\"}"; v="${v%\"}" ;;
        \'*\') v="${v#\'}"; v="${v%\'}" ;;
    esac
    printf '%s' "$v"
}

autopilot_norm="$(trim_unquote "$autopilot")"
autopilot_grant_norm="$(trim_unquote "$autopilot_grant")"

# Only when it is on, and on its own line. An "Autopilot: off" line in
# every injection is noise in the one block that has to stay short enough
# to be read in full.
autopilot_line=""
if [ -n "$autopilot_norm" ]; then
    case "$autopilot_norm" in
        [Oo][Ff][Ff]) ;;
        *)
            autopilot_line="
Autopilot: ${autopilot_norm} (granted ${autopilot_grant_norm}) — this run continues without a human present. Check the Session source line above before acting on it: see baton-resume."
            ;;
    esac
fi

context="This repository runs under baton. Before anything else, use the baton-resume skill: read docs/baton/constitution.md and docs/baton/state.md, verify them against the repository with baton-observe, and only then continue.

Goal: ${goal}
Operating mode: ${mode}
Non-negotiables: ${rules}
Next action: ${next}
Session source: ${session_source} (unknown counts as startup, never as compact)${autopilot_line}

These five lines are a summary for orientation, not a substitute for reading the files."

# state.md is prose for a human and an agent to read, not an opaque blob,
# and a control byte below 0x20 other than \n, \r, \t has no business in
# it. Strip those before escaping rather than \u-encoding them: the four
# lines below are explicitly a summary for orientation, so dropping a
# stray control byte loses nothing that mattered, and it keeps the escaper
# below honest -- it only has to handle the characters it lists.
strip_disallowed_control_chars() {
    LC_ALL=C tr -d '\000-\010\013\014\016-\037'
}

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context="$(printf '%s' "$context" | strip_disallowed_control_chars)"
escaped="$(escape_for_json "$context")"

# CLAUDE_PLUGIN_ROOT says nothing about which shape the caller reads -- it
# is set whenever Claude Code runs this hook at all, so branching on it
# only ever picks the Claude Code shape. COPILOT_CLI is the one signal that
# corresponds to something real: Copilot CLI (v1.0.11+) sets it and reads
# the top-level additionalContext shape (the SDK standard). Everything
# else, including Claude Code, reads hookSpecificOutput.additionalContext
# -- confirmed against the official plugin-dev hook-development skill and
# the SessionStart hooks shipped by learning-output-style and
# explanatory-output-style, which emit it unconditionally. Baton ships no
# Cursor manifest, so there is deliberately no third branch for it here.
if [ -n "${COPILOT_CLI:-}" ]; then
    printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
else
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
fi

exit 0
