#!/usr/bin/env bash
# After a compaction, point the agent at the state file and hand it the
# lines that matter, so recovery does not depend on remembering to recover.
set -euo pipefail

project="${CLAUDE_PROJECT_DIR:-$PWD}"
cd "$project" 2>/dev/null || exit 0

# CLAUDE_PROJECT_DIR is wherever the session started, not necessarily the
# git top level -- a monorepo session can start in a subdirectory just as
# easily as at the root. baton-lock, baton-write and baton-journal all had
# to re-resolve to the repository root for exactly this reason (see their
# comments): a hook invoked from a subdirectory would otherwise find no
# docs/baton/state.md and silently inject nothing, right when recovery
# depends on it. A baton run is always a git run, so anything that is not
# inside a repository at all genuinely is not our concern.
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    cd "$(git rev-parse --show-toplevel)"
else
    exit 0
fi

state="docs/baton/state.md"
[ -f "$state" ] || exit 0

# Claude Code passes hook input as JSON on stdin: session_id, transcript_path,
# hook_event_name, and source -- the field hooks.json's own SessionStart
# matcher (startup|resume|clear|compact|fork) already distinguishes. Until
# this hook reads it, that distinction never reaches the agent: baton-resume
# continues silently after a compact and waits on a fresh start, and it has
# no way to tell those apart.
#
# `cat` in a command substitution can hang here, on the one input shape
# this hook actually receives. An open pipe/FIFO whose writer already sent
# a complete payload but never closes leaves `cat` waiting for an EOF that
# is not coming -- under hooks.json's 15-second SessionStart timeout, that
# stalls every session start for the full 15 seconds and then injects
# NOTHING, the exact failure this hook exists to prevent. A closed fd 0
# (<&-) is worse: bash has been seen reassigning fd 0 to the command
# substitution's own output pipe in that shape, so `cat` ends up reading
# the pipe it writes to and deadlocks forever, with no hook timeout able to
# see it -- the deadlock is inside the read, before the hook's own logic
# ever gets control back.
#
# `read -t` reads directly from the current fd -- no subshell, no pipe
# reassignment -- and bounds the wait unconditionally; verified against
# both failure shapes above, and against bash 3.2 (the system bash on
# macOS, and the oldest this hook is likely to run under). -d '' reads the
# whole input, embedded newlines included, as one undelimited chunk, so a
# multi-line (pretty-printed) payload is captured whole rather than
# truncated at the first line. On a timeout, bash 3.2 discards whatever had
# already arrived rather than keeping the partial read (bash 4.4+ changed
# this) -- here that is the right outcome anyway: input that genuinely
# could not be read within the bound falls through to "unknown" exactly
# like no input at all, the same fail-safe reading either way.
hook_input=""
IFS= read -r -t 2 -d '' hook_input 2>/dev/null || true

# source is a five-value enum, so a targeted extraction is honest here; a
# general JSON parser hand-rolled in sed would not be. grep -o, not a
# single greedy sed substitution: sed's `.*"source"...` only backtracks a
# leading .* as far as it must, which favors the LAST match when the JSON
# is minified onto one line -- the opposite of every other duplicate-field
# read in this file, and a real behavior difference from the pretty-printed
# case, where each field is already on its own line. grep -o instead emits
# every match as its own line, in the order it appears, so `head -1`
# genuinely takes the first occurrence either way. An absent field,
# malformed JSON, and a value outside the enum all collapse to the same
# "unknown" -- and because the value is validated against a fixed set of
# literals before it is ever interpolated below, a hostile string on stdin
# (an embedded quote, an attempted break-out) can only ever become one of
# these six fixed words, never reach the JSON escaper as untrusted data.
# || true on the whole pipeline, not just the sed at the end: grep exits 1
# when nothing matches -- the ordinary case for empty stdin or a payload
# with no source field -- and under pipefail that failure is the
# pipeline's own exit status, which silently aborts this entire script
# under set -e before it ever reaches a fallback. There is no fallback to
# reach if the abort happens here.
session_source="$(printf '%s' "$hook_input" | grep -o '"source"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -n 's/.*"\([^"]*\)"[[:space:]]*$/\1/p' || true)"
case "$session_source" in
    startup|resume|clear|compact|fork) ;;
    *) session_source="unknown" ;;
esac

# Every line's line-final \r stripped once, up front: state.md is
# agent-written, and a CRLF-authored file carries \r on every line -- the
# frontmatter delimiter ("---\r" does not match "^---$" below), and
# otherwise a CRLF file's Goal would carry a trailing \r into the injected
# context too.
state_content="$(awk '{ sub(/\r$/, ""); print }' "$state")"

field() {
    printf '%s\n' "$state_content" | sed -n "s/^\*\*$1:\*\* *//p" | head -1
}

goal="$(field 'Goal')"
mode="$(field 'Operating mode')"
rules="$(field 'Non-negotiables')"
next="$(printf '%s\n' "$state_content" | sed -n 's/^- \*\*Next action:\*\* *//p' | head -1)"

# Anchored to the FIRST block only, and only if it closes: an unanchored,
# repeating sed range (/^---$/,/^---$/p) matches every "---"..."---" pair
# in the file and concatenates them, so a schema example in the body -- a
# fenced block showing what a real grant looks like, the natural way to
# illustrate a YAML field in prose -- becomes indistinguishable from the
# frontmatter it is illustrating: with no real autopilot field to win a
# head -1 tie, the body's fake grant would win outright. Same construction
# as baton-gate's constitution read (see its comment): NR==1 requires the
# block to open on the file's first line, closed is only set on a genuine
# terminator, and END only prints if closed was reached, so an
# unterminated "---" opens a range that runs to EOF and is still refused.
frontmatter="$(printf '%s\n' "$state_content" | awk '
    NR==1 && $0=="---" { infm=1; next }
    infm && $0=="---"  { closed=1; exit }
    infm               { buf = buf $0 "\n" }
    END                { if (closed) printf "%s", buf }
')"
autopilot="$(printf '%s\n' "$frontmatter" | sed -n 's/^autopilot: *//p' | head -1)"
autopilot_grant="$(printf '%s\n' "$frontmatter" | sed -n 's/^autopilot_grant: *//p' | head -1)"

# state.md is written by an agent, not validated input, so the byte-level
# shape of a scalar drifts: a trailing space, a quoted string. Shared by
# autopilot (the on/off decision, below) and autopilot_grant (displayed
# verbatim: the line is what a compacted session reads to know which
# entry authorised this, and a stray quote or trailing space would make
# the id it prints not the id a human wrote).
trim_unquote() {
    local v
    v="$(printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    case "$v" in
        \"*\") v="${v#\"}"; v="${v%\"}" ;;
        \'*\') v="${v#\'}"; v="${v%\'}" ;;
    esac
    printf '%s' "$v"
}

autopilot_norm="$(trim_unquote "$autopilot")"
autopilot_grant_norm="$(trim_unquote "$autopilot_grant")"

# A positive whitelist, not a blacklist of "off" spellings: the field's
# real meaning is that "all" or a bare wave number turns autopilot ON, and
# nothing else does. A blacklist of "off" spellings falls through on
# anything it did not anticipate and announces a grant -- including an
# inline YAML comment ("off          # off | all | 3", the exact shape the
# design spec documents this field with; trim_unquote strips whitespace
# and quotes, not a trailing comment), "false", "no", "none", "null", an
# empty field, or a typo like "al". Under the whitelist, all of those fail
# toward NO autonomy instead -- the only direction an unrecognized value
# is allowed to fail in, for a field only a human is meant to turn on.
is_autopilot_on=0
case "$autopilot_norm" in
    all) is_autopilot_on=1 ;;
    ''|*[!0-9]*) ;;  # neither "all" nor purely digits -- no grant
    *) is_autopilot_on=1 ;;  # purely digits, non-empty -- a wave number
esac

# Only when it is on, and on its own line. An "Autopilot: off" line in
# every injection is noise in the one block that has to stay short enough
# to be read in full.
autopilot_line=""
if [ "$is_autopilot_on" = "1" ]; then
    autopilot_line="
Autopilot: ${autopilot_norm} (granted ${autopilot_grant_norm}) — this run continues without a human present. Check the Session source line above before acting on it: see baton-resume."
fi

context="This repository runs under baton. Before anything else, use the baton-resume skill: read docs/baton/constitution.md and docs/baton/state.md, verify them against the repository with baton-observe, and only then continue.

Goal: ${goal}
Operating mode: ${mode}
Non-negotiables: ${rules}
Next action: ${next}
Session source: ${session_source} (unknown counts as startup, never as compact)${autopilot_line}

These lines are a summary for orientation, not a substitute for reading the files."

# state.md is prose for a human and an agent to read, not an opaque blob,
# and a control byte below 0x20 other than \n, \r, \t has no business in
# it. Strip those before escaping rather than \u-encoding them: the lines
# above are explicitly a summary for orientation, so dropping a stray
# control byte loses nothing that mattered, and it keeps the escaper below
# honest -- it only has to handle the characters it lists.
strip_disallowed_control_chars() {
    LC_ALL=C tr -d '\000-\010\013\014\016-\037'
}

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context="$(printf '%s' "$context" | strip_disallowed_control_chars)"
escaped="$(escape_for_json "$context")"

# CLAUDE_PLUGIN_ROOT says nothing about which shape the caller reads -- it
# is set whenever Claude Code runs this hook at all, so branching on it
# only ever picks the Claude Code shape. COPILOT_CLI is the one signal that
# corresponds to something real: Copilot CLI (v1.0.11+) sets it and reads
# the top-level additionalContext shape (the SDK standard). Everything
# else, including Claude Code, reads hookSpecificOutput.additionalContext
# -- confirmed against the official plugin-dev hook-development skill and
# the SessionStart hooks shipped by learning-output-style and
# explanatory-output-style, which emit it unconditionally. Baton ships no
# Cursor manifest, so there is deliberately no third branch for it here.
if [ -n "${COPILOT_CLI:-}" ]; then
    printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
else
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
fi

exit 0
